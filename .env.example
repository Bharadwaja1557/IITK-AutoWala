# ─────────────────────────────────────────────────────────────────────────────
# IITK AutoWala — environment
#
# Copy to .env and adjust. Every key below is read through a Zod schema at API
# startup (apps/api/src/config/env.ts). A missing or malformed value aborts the
# boot with the offending key named — the process never starts half-configured.
#
# Values shown are working local defaults unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode. One of: development | test | production
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# MongoDB connection string.
#   local (mongod on host):  mongodb://127.0.0.1:27017/iitk-autowala
#   docker compose:          mongodb://mongo:27017/iitk-autowala  (set in compose)
MONGODB_URI=mongodb://127.0.0.1:27017/iitk-autowala

# REQUIRED. Signing secret for driver JWTs. Minimum 32 characters — boot fails
# below that. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long a driver stays logged in. Any `ms`-style span jsonwebtoken accepts.
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing. 10 is ~50ms/hash on a laptop.
# Raise for production, lower only if tests get slow.
BCRYPT_ROUNDS=10

# How long one "I'm available" tap stays live before it self-expires.
# This is the whole product constraint: availability is self-declared and
# bounded, because there is no GPS tracking to fall back on.
AVAILABILITY_TTL_MINUTES=45

# Default search radius for rider discovery, in metres. The IITK campus is
# roughly 2km across, so 5000 covers all of it plus the approach roads.
DEFAULT_SEARCH_RADIUS_METERS=5000

# Hard cap on how many drivers one rider query returns.
MAX_NEARBY_RESULTS=20

# When true: seed synthetic drivers on boot, and re-seed inline if a rider
# query finds zero live sessions. Keeps a deployed demo populated without a
# cron. MUST be false in tests — inline re-seeding makes geo assertions
# non-deterministic.
DEMO_MODE=true
