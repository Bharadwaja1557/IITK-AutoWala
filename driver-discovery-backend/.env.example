# Backend environment — copy to `.env` and fill in. Never commit `.env`.
# Loaded by dotenv at db.js:28 and index.js:192.

# Port the Express server listens on. Read at index.js:195. Defaults to 4000 if unset.
PORT=4000

# MySQL connection. Read at db.js:32-36.
# These four were hardcoded in the original hackathon code and were replaced with
# env reads during the restore; see WORK.md, "Secrets found".
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=iitk_autowala
DB_PORT=3306
