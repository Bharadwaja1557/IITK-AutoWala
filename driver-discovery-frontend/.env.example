# Frontend environment — copy to `.env` and adjust. Never commit `.env`.
# Create React App only exposes variables prefixed REACT_APP_.

# Base URL of the backend API.
# Read at src/panels/RiderPanel.js:101, DriverPanel.js:4, AdminPanel.js:4.
# In the original hackathon code these three were hardcoded and disagreed with each
# other — see WORK.md, "Changed from the original".
REACT_APP_API_BASE=http://localhost:4000
